APP_NAME=wordpress-bedrock-frankenphp

# Application
WP_ENV=development
WP_ENVIRONMENT_TYPE=local
WP_HOME=http://localhost
WP_SITEURL=http://localhost/wp

# Runtime
# true = FrankenPHP, false = PHP-FPM + Nginx
FRANKENPHP_ENABLED=true
# classic = normal PHP requests; worker = opt-in long-lived worker mode
FRANKENPHP_MODE=classic
PHP_VERSION=8.3
SERVER_NAME=:80
HTTP_PORT=80
HTTPS_PORT=443
HTTP3_PORT=443
HEALTHCHECK_URL=http://localhost

# Database
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=wordpress
DB_HOST=mysql
DB_PREFIX=wp_

MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress
MYSQL_ROOT_PASSWORD=change-me

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# WordPress secrets - generate unique values for each environment.
AUTH_KEY=
SECURE_AUTH_KEY=
LOGGED_IN_KEY=
NONCE_KEY=
AUTH_SALT=
SECURE_AUTH_SALT=
LOGGED_IN_SALT=
NONCE_SALT=

# Runtime behavior
DISABLE_WP_CRON=false
IMAGE_TAG=latest
