{
    frankenphp {
        max_requests ${FRANKENPHP_MAX_REQUESTS:500}
    }

    order request_header before php_server
    order php_server before file_server
}

${SERVER_NAME:localhost} {
    root * /app/web
    encode br zstd gzip

    @health path /healthz
    respond @health 200

    @static {
        path *.css *.js *.jpg *.jpeg *.png *.gif *.svg *.webp *.ico *.woff *.woff2 *.ttf
    }
    header @static Cache-Control "public, max-age=604800, immutable"

    php_server {
        worker {
            file /app/web/index.php
            num ${FRANKENPHP_WORKERS:4}
            max_consecutive_failures 6
        }
    }

    file_server
}
